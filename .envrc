export NIXPKGS_ALLOW_UNFREE=1
use flake

# nix-direnv may reuse a cached flake environment. Track the runtime assignment
# and refresh it after importing that environment so a fallback reaches callers.
_sinex_nats_assignment="$SINEX_DEV_STATE_DIR/nats.port"
watch_file "$_sinex_nats_assignment"
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
  _sinex_nats_selected="$(flock --shared "$XDG_RUNTIME_DIR/sinex-dev-nats-start.lock" sh -c 'if [ -r "$1" ]; then cat "$1"; fi' sh "$_sinex_nats_assignment")"
elif [ -r "$_sinex_nats_assignment" ]; then
  _sinex_nats_selected="$(cat "$_sinex_nats_assignment")"
else
  _sinex_nats_selected=""
fi
if [[ "$_sinex_nats_selected" =~ ^[0-9]{1,5}$ ]] && (( 10#$_sinex_nats_selected > 0 && 10#$_sinex_nats_selected <= 65535 )); then
  export SINEX_DEV_NATS_PORT="$_sinex_nats_selected"
  export SINEX_NATS_URL="nats://127.0.0.1:$_sinex_nats_selected"
fi
unset _sinex_nats_assignment _sinex_nats_selected
