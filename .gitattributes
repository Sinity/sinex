# ── Generated / non-code ─────────────────────────────────────────────
# GitHub language stats (linguist-generated): excluded from stats
# -diff: suppressed in git diff output (shows "Binary files differ")

# Lock files
Cargo.lock linguist-generated
flake.lock linguist-generated


# ── Better diffs ─────────────────────────────────────────────────────
*.json diff=json
*.toml diff=toml
*.yml diff=yaml
*.yaml diff=yaml
*.nix diff
*.sql diff

# ── Line endings ─────────────────────────────────────────────────────
* text=auto
*.rs text eol=lf
*.nix text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.sql text eol=lf

# ── Binary files ─────────────────────────────────────────────────────
*.age binary

# ── Export control (git archive) ─────────────────────────────────────
.github/ export-ignore
.claude/ export-ignore
secret/ export-ignore

tests/sources/** -text
